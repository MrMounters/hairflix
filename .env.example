# Copy to .env.local locally or add through the Vercel project environment settings.
# Never commit actual credentials. Booking stays disabled until activation.
BOOKING_ENABLED=false
BOOKING_ACTIVE_LOCATIONS=
BOOKING_CAPACITY_JSON={}
SERVICE_CATALOG_JSON={}
PUBLIC_ORIGIN=https://hairflix.vercel.app
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
BOOKING_ADMIN_TOKEN=

# Stripe Connect SANDBOX ONLY. Keys belong to the SaaS PLATFORM, not a shop.
# Do not reuse STRIPE_API_KEY (legacy standalone deposit checkout).
CONNECT_ENABLED=true
CONNECT_MODE=sandbox
STRIPE_CONNECT_API_KEY=
STRIPE_CONNECT_PUBLISHABLE_KEY=
STRIPE_CONNECT_WEBHOOK_SECRET=
# Generate 32+ random characters; server-only cookie signing secret.
CONNECT_SESSION_SECRET=
# Server-authorized principals, password HASHES only. See docs/stripe-connect-sandbox.md.
CONNECT_SANDBOX_USERS_JSON={}

# Whole-site invitation gate. Configure secrets in Vercel; never commit the password.
SITE_ACCESS_ENABLED=true
SITE_ACCESS_PASSWORD_HASH=
SITE_ACCESS_COOKIE_SECRET=
