# Copy to .env.local locally or add through the Vercel project environment settings.
# Never commit actual credentials. Booking stays disabled until activation.
BOOKING_ENABLED=false
BOOKING_ACTIVE_LOCATIONS=
BOOKING_CAPACITY_JSON={}
SERVICE_CATALOG_JSON={}
PUBLIC_ORIGIN=https://hairflix.vercel.app
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
BOOKING_ADMIN_TOKEN=

# Stripe Connect SANDBOX ONLY. Keys belong to the SaaS PLATFORM, not a shop.
# Do not reuse STRIPE_API_KEY (legacy standalone deposit checkout).
CONNECT_ENABLED=true
CONNECT_MODE=sandbox
STRIPE_CONNECT_API_KEY=
STRIPE_CONNECT_PUBLISHABLE_KEY=
STRIPE_CONNECT_WEBHOOK_SECRET=
# Generate 32+ random characters; server-only cookie signing secret.
CONNECT_SESSION_SECRET=
# Server-authorized principals, password HASHES only. See docs/stripe-connect-sandbox.md.
CONNECT_SANDBOX_USERS_JSON={}

# Private app invitation gate (the landing page stays public). Configure secrets in Vercel; never commit the password.
SITE_ACCESS_ENABLED=true
SITE_ACCESS_PASSWORD_HASH=
SITE_ACCESS_COOKIE_SECRET=

# Shared native Hairflix app. Use Upstash above on Vercel; SQLite only on persistent Node hosts.
# APP_DATABASE_FILE=./hairflix-app.sqlite
# Internal, clearly marked test bookings; does not sync with Squire.
APP_MODE=pilot
APP_LIVE_BOOKING=false
# Generate independently, at least 32 random characters. Server-only; remove bootstrap token after activation.
APP_BOOTSTRAP_TOKEN=
APP_WORKER_SECRET=
# Browser origins allowed to use the bearer-authenticated platform API (comma separated).
APP_WEB_ORIGINS=
# Optional Resend/Twilio/Expo push providers. These do not enable card payments.
APP_EMAIL_API_KEY=
APP_EMAIL_FROM=
APP_SMS_ACCOUNT_ID=
APP_SMS_AUTH_TOKEN=
APP_SMS_FROM=
APP_EXPO_ACCESS_TOKEN=
